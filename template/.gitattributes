# Normalize text files to LF on every platform.
* text=auto eol=lf

# Binary files: never normalized or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.jar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.sqlite binary
*.db binary

# If PowerShell scripts are added, give them CRLF line endings:
# *.ps1 text eol=crlf
